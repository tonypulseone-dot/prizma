# Google PageSpeed Insights API key (optional; without it the public quota is used)
PSI_API_KEY=
# Set to 1 to skip PageSpeed (e.g. in tests or offline)
PSI_DISABLED=0
# Where audit JSON files are stored
AUDIT_DATA_DIR=.data/audits
# Max pages crawled per audit on the free plan
AUDIT_MAX_PAGES=20
# Allow auditing localhost/private IPs (only for local testing!)
AUDIT_ALLOW_PRIVATE_HOSTS=0
# Public base URL of this site (used in downloaded reports and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
